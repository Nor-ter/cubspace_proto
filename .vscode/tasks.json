{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ticket 실행",
      "type": "process",
      "command": "npm",
      "args": ["run", "ticket", "--", "run"],
      "windows": {
        "command": "npm.cmd"
      },
      "problemMatcher": []
    },
    {
      "label": "ClickUp task 실행",
      "type": "process",
      "command": "npm",
      "args": ["run", "ticket", "--", "start", "${input:taskId}"],
      "windows": {
        "command": "npm.cmd"
      },
      "problemMatcher": []
    },
    {
      "label": "검사와 리뷰 이어가기",
      "type": "process",
      "command": "npm",
      "args": ["run", "ticket", "--", "continue", "${input:runId}"],
      "windows": {
        "command": "npm.cmd"
      },
      "problemMatcher": []
    },
    {
      "label": "ClickUp 결과 제출",
      "type": "process",
      "command": "npm",
      "args": ["run", "ticket", "--", "submit", "${input:runId}"],
      "windows": {
        "command": "npm.cmd"
      },
      "problemMatcher": []
    },
    {
      "label": "개발 서버",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "runId",
      "type": "promptString",
      "description": "작업 실행 시 출력된 RUN_ID"
    },
    {
      "id": "taskId",
      "type": "promptString",
      "description": "ClickUp 작업 URL 끝의 task ID"
    }
  ]
}
