{
  "name": "cubspace-onboarding",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run preview",
    "lint": "oxlint tests scripts && npm --prefix frontend run lint",
    "format": "oxfmt",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "ticket": "node scripts/ticket.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "environment:setup": "node scripts/setup-environment.mjs",
    "environment:check": "node scripts/check-environment.mjs",
    "browser:install": "playwright install chromium",
    "test:prolog": "node scripts/prolog.mjs -q -s tests/run-rules.pl -g run_tests -t halt",
    "prolog": "node scripts/prolog.mjs",
    "postinstall": "npm --prefix frontend ci"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
