{
  "name": "cubspace-onboarding",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components src tests scripts",
    "format": "oxfmt",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "ticket": "node scripts/ticket.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "environment:setup": "node scripts/setup-environment.mjs",
    "environment:check": "node scripts/check-environment.mjs",
    "browser:install": "playwright install chromium",
    "test:prolog": "swipl -q -s tests/run-rules.pl -g run_tests -t halt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@types/three": "^0.184.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "^0.18.7",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "playwright": "^1.58.2"
  },
  "type": "module"
}
